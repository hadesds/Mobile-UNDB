POSTGRES_DB=teia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

#pra n digitar -f toda vez na hora de subir container docker
COMPOSE_FILE=docker-compose.dev.yml

DJANGO_SECRET_KEY="senha-forte-para-docker"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,IP_WIN

ALUNO_EMAIL_DOMINIOS=aluno.undb.edu.br

# Popula dados fictícios de demonstração ao subir o container (0 = desliga)
SEED_DEMO=1
# Senha dos usuários criados pelo seed (só na criação)
SEED_SENHA=Teia@Demo2026
# Formulário de vagas das empresas (módulo solicitacoes)
# Vazio = link aponta para a página do próprio Django (/empresas/vagas/<token>/)
SOLICITACOES_FORMULARIO_URL=
FORMULARIO_EMPRESA_THROTTLE=30/min
GERAR_LINK_EMPRESA_THROTTLE=60/hour

# Supabase Storage (produção). Vazio = arquivos ficam em MEDIA_ROOT (disco local).
# Bucket privado + chave de Storage > Settings > S3 Connection.
SUPABASE_STORAGE_BUCKET=
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
